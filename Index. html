<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Life Voice Chat</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:linear-gradient(135deg,#12001f,#24104f,#090d25);
  color:white;
  min-height:100vh;
}

.header{
  text-align:center;
  padding:35px 20px 20px;
}

.logo{
  font-size:55px;
}

h1{
  margin:10px 0 5px;
  font-size:32px;
}

.subtitle{
  color:#cfc9e8;
  font-size:15px;
}

.card{
  width:90%;
  max-width:430px;
  margin:25px auto;
  padding:25px;
  background:rgba(255,255,255,0.09);
  border:1px solid rgba(255,255,255,0.15);
  border-radius:25px;
  box-shadow:0 15px 40px rgba(0,0,0,0.4);
}

.card h2{
  text-align:center;
  margin-top:0;
}

input{
  width:100%;
  padding:15px;
  margin:9px 0;
  border:0;
  outline:0;
  border-radius:13px;
  background:#fff;
  color:#222;
  font-size:16px;
}

button{
  width:100%;
  padding:15px;
  margin-top:12px;
  border:0;
  border-radius:13px;
  font-size:17px;
  font-weight:bold;
  color:white;
  background:linear-gradient(90deg,#7c4dff,#e040fb);
}

button:active{
  transform:scale(.97);
}

.mic{
  background:linear-gradient(90deg,#00bfa5,#00c853);
}

.status{
  text-align:center;
  margin-top:18px;
  color:#65ffb0;
  font-size:14px;
}

.features{
  display:flex;
  justify-content:space-around;
  text-align:center;
  width:90%;
  max-width:430px;
  margin:25px auto;
}

.feature{
  font-size:13px;
  color:#ddd;
}

.feature div{
  font-size:28px;
  margin-bottom:6px;
}
</style>
</head>

<body>

<div class="header">
  <div class="logo">🎙️</div>
  <h1>Life Voice Chat</h1>
  <div class="subtitle">Connect • Talk • Enjoy</div>
</div>

<div class="card">

  <h2>Join Voice Room</h2>

  <input id="name" type="text" placeholder="Enter your name">

  <input id="room" type="text" placeholder="Enter Room ID">

  <button onclick="joinRoom()">🚪 Join Room</button>

  <button class="mic" onclick="testMic()">🎤 Test Microphone</button>

  <div class="status" id="status">
    Ready to connect
  </div>

</div>

<div class="features">
  <div class="feature">
    <div>👥</div>
    Voice Rooms
  </div>

  <div class="feature">
    <div>🎤</div>
    Live Voice
  </div>

  <div class="feature">
    <div>💬</div>
    Chat
  </div>
</div>

<script>

function joinRoom(){

  let name=document.getElementById("name").value.trim();
  let room=document.getElementById("room").value.trim();

  if(name==="" || room===""){
    document.getElementById("status").innerText=
    "⚠️ Please enter your name and Room ID";
    return;
  }

  document.getElementById("status").innerText=
  "✅ Welcome "+name+" • Room "+room;

}

async function testMic(){

  try{

    await navigator.mediaDevices.getUserMedia({
      audio:true
    });

    document.getElementById("status").innerText=
    "🎤 Microphone permission granted";

  }catch(error){

    document.getElementById("status").innerText=
    "❌ Microphone permission denied";

  }

}

</script>

</body>
</html>
